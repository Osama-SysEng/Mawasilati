# Mawasilati backend — example environment (copy to .env)
# cp .env.example .env  (never commit real secrets)
ENVIRONMENT=development
APP_NAME=Mawasilati API

# --- Structured logging (stdlib JSON, no extra deps) ---
SERVICE_NAME=mawasilati-api
LOG_LEVEL=INFO
GIT_SHA=dev

# --- Primary store ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mawasilati
REDIS_URL=redis://localhost:6379/0

# --- Auth (placeholders only) ---
SECRET_KEY=change-me-to-at-least-32-characters-long-secret

# --- Client ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
