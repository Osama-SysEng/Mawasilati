# Mawasilati - Environment Configuration Example
# Copy to .env and fill in real values: cp .env.example .env (or backend/.env)

# ---- App ----
ENVIRONMENT=development
# Options: development | test | staging | production

# ---- Database ----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mawasilati
POSTGRES_DB=mawasilati
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Security / JWT ----
SECRET_KEY=change-me-to-a-long-random-value-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_SESSION_BOUND_TOKENS=true

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Operational ----
TRIP_QUOTE_TTL_MINUTES=10
REQUIRE_SIGNED_QUOTES_IN_PRODUCTION=true
LOADTEST_BEARER_TOKEN=
